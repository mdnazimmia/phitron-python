   "source": [
    "inp = input()\n",
    "numbers = inp.split()\n",
    "\n",
    "x = float(numbers[0])\n",
    "y = float(numbers[1])\n",
    "if x >= y:\n",
    "    print(\"ON\")\n",
    "else:\n",
    "    print(\"OFF\")\n"
